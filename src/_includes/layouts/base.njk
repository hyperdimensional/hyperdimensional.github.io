{%- set pageTitle = title or site.name -%}
{%- set pageDescription = description or site.description -%}
{%- set isHome = page.url == "/" -%}
<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:image" content="{{ site.url }}/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The hyperdimensional mark and name">
{%- endif %}
{%- if isHome %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}/","logo":"{{ site.url }}/logo.svg","foundingDate":"{{ site.established | unixToDate }}"}</script>
{%- endif %}
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<style>
{% include "css/site.css" %}
</style>
</head>
<body>
<header class="site-header">
{%- if isHome %}
{% logo "mark" %}
{%- else %}
<a class="mark-link" href="/" aria-label="{{ site.name }} home">{% logo "mark" %}</a>
{%- endif %}
</header>
<main>
{{ content | safe }}
</main>
<footer class="site-footer">
{%- set since = site.established | unixToYear %}
<p>established <time datetime="{{ site.established | unixToIso }}">{{ site.established }}</time></p>
<p>© <abbr title="{{ since }}–{{ build.year }}">{{ since | roman }}–{{ build.year | roman }}</abbr></p>
</footer>
</body>
</html>
