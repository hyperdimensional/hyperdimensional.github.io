{
  "name": "hyperdimensional.net",
  "private": true,
  "type": "module",
  "description": "Source for www.hyperdimensional.net, built with Eleventy",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "test": "eleventy --quiet && npm run test:static && npm run test:html && npm run test:browser",
    "test:static": "node --test tests/spec.test.mjs tests/content.test.mjs",
    "test:html": "html-validate \"_site/**/*.html\"",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.mjs",
    "test:live": "node --test tests/live.test.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@axe-core/playwright": "4.14.0",
    "html-validate": "11.16.4",
    "playwright": "1.63.0"
  }
}
